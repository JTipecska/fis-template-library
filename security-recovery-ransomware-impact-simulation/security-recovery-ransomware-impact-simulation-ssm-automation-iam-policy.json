{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowEBSSnapshotDeletion",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeSnapshots",
                "ec2:DeleteSnapshot"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowBackupRecoveryPointDeletion",
            "Effect": "Allow",
            "Action": [
                "backup:ListRecoveryPointsByBackupVault",
                "backup:DescribeBackupVault",
                "backup:DeleteRecoveryPoint"
            ],
            "Resource": "arn:aws:backup:<YOUR REGION>:<YOUR AWS ACCOUNT>:backup-vault:<YOUR BACKUP VAULT NAME>"
        },
        {
            "Sid": "AllowKMSKeyPolicyManagement",
            "Effect": "Allow",
            "Action": [
                "kms:GetKeyPolicy",
                "kms:PutKeyPolicy",
                "kms:DescribeKey"
            ],
            "Resource": "arn:aws:kms:<YOUR REGION>:<YOUR AWS ACCOUNT>:key/<YOUR KMS KEY ID>"
        },
        {
            "Sid": "AllowRDSSecurityGroupIsolation",
            "Effect": "Allow",
            "Action": [
                "rds:DescribeDBInstances",
                "rds:ModifyDBInstance"
            ],
            "Resource": "arn:aws:rds:<YOUR REGION>:<YOUR AWS ACCOUNT>:db:<YOUR RDS INSTANCE IDENTIFIER>"
        },
        {
            "Sid": "AllowSSMParameterStoreForKMSPolicyBackup",
            "Effect": "Allow",
            "Action": [
                "ssm:PutParameter",
                "ssm:GetParameter",
                "ssm:DeleteParameter"
            ],
            "Resource": "arn:aws:ssm:<YOUR REGION>:<YOUR AWS ACCOUNT>:parameter/fis-security/ransomware/*"
        },
        {
            "Sid": "AllowCloudWatchMetrics",
            "Effect": "Allow",
            "Action": "cloudwatch:PutMetricData",
            "Resource": "*"
        },
        {
            "Sid": "AllowCloudWatchLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "*"
        }
    ]
}
