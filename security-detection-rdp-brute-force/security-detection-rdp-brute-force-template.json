{
    "description": "Simulate RDP brute force attack from attacker (Red1) to victim (Blue2 Windows) to validate GuardDuty UnauthorizedAccess:EC2/RDPBruteForce detection.",
    "targets": {
        "attackerInstances": {
            "resourceType": "aws:ec2:instance",
            "resourceTags": {
                "FIS-Ready": "True",
                "Name": "fis-security-red1"
            },
            "selectionMode": "COUNT(1)"
        }
    },
    "actions": {
        "run-rdp-brute-force": {
            "actionId": "aws:ssm:send-command",
            "description": "Run RDP brute force simulation script on the attacker instance",
            "parameters": {
                "duration": "PT5M",
                "documentArn": "arn:aws:ssm:<YOUR REGION>:<YOUR AWS ACCOUNT>:document/fis-security-rdp-brute-force",
                "documentParameters": "{\"TargetInstance\":\"10.0.0.12\",\"InstallDependencies\":\"False\"}"
            },
            "targets": {
                "Instances": "attackerInstances"
            }
        }
    },
    "stopConditions": [
        {
            "source": "none"
        }
    ],
    "roleArn": "arn:aws:iam::<YOUR AWS ACCOUNT>:role/<YOUR FIS ROLE NAME>",
    "tags": {
        "Name": "fis-security-rdp-brute-force",
        "Purpose": "security-chaos-testing"
    },
    "experimentOptions": {
        "accountTargeting": "single-account",
        "emptyTargetResolutionMode": "fail"
    }
}
