{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3BucketDiscovery",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketTagging"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowS3GetBucketPolicy",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowS3ModifyBucketPolicy",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::<YOUR INPUT BUCKET NAME>",
        "arn:aws:s3:::<YOUR OUTPUT BUCKET NAME>"
      ]
    }
  ]
}
